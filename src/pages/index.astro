---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, products, sectors, faqs, testimonials, whatsappUrl } from '../data/site';
import { localBusinessSchema, faqSchema } from '../lib/schema';

// Título ≤ 60 caracteres con la palabra clave principal + ciudad
const title = `Tanques de Agua en Bogotá | ${site.name}`;

const steps = [
  { icon: 'whatsapp', title: 'Cuéntanos qué necesitas', text: 'Escríbenos por WhatsApp, llámanos o usa el formulario.' },
  { icon: 'users', title: 'Te asesoramos', text: 'Te ayudamos a elegir el tipo y la capacidad ideal para tu uso.' },
  { icon: 'certificate', title: 'Recibes tu cotización', text: 'Precio claro y sin compromiso, con las especificaciones del producto.' },
  { icon: 'tank', title: 'Suministro y soporte', text: 'Te acompañamos con servicio técnico para implementar y mantener tu sistema.' },
] as const;
---

<Base title={title} description={site.description} schema={[localBusinessSchema(), faqSchema(faqs)]}>
  <!-- HERO -->
  <section class="hero">
    <Img
      file="sistema-de-riego.jpg"
      alt="Sistema de riego en un cultivo"
      priority
      sizes="100vw"
      widths={[640, 960, 1280, 1920]}
      class="hero__bg"
    />
    <div class="container hero__inner">
      <p class="hero__badge"><Icon name="certificate" size={16} /> 45 años de experiencia · Bogotá, Colombia</p>
      <h1>Tanques de agua con la mejor <span>resistencia</span> y la asesoría que necesitas</h1>
      <p class="hero__lead">
        Tanques de agua potable, cafeteros y ganaderos, sistemas sépticos y valvulería para los sectores residencial,
        construcción y agropecuario.
      </p>
      <div class="hero__actions">
        <a class="btn" href={whatsappUrl()} target="_blank" rel="noopener" data-track="hero">
          <Icon name="whatsapp" /> ¡Solicitar cotización!
        </a>
        <a class="btn btn--light" href="/productos">Ver productos <Icon name="arrow" /></a>
      </div>
      <ul class="hero__stats">
        {site.stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- PRODUCTOS -->
  <section class="section" id="productos">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Portafolio</p>
        <h2>Soluciones para cada necesidad</h2>
        <p class="lead">Almacenamiento de agua, tratamiento de aguas residuales y control de flujo con altos estándares de calidad.</p>
      </div>
      <div class="products">
        {
          products.map((p, i) => (
            <a class:list={['prod', { 'prod--wide': i === 0 }]} href={`/productos/${p.slug}`}>
              <div class="prod__media">
                <Img file={p.image} alt={p.name} icon={p.icon} sizes="(min-width: 1000px) 400px, 100vw" widths={[320, 480, 720]} />
              </div>
              <div class="prod__body">
                <h3>{p.name}</h3>
                <p>{p.summary}</p>
                <span class="prod__more">Ver producto <Icon name="arrow" size={18} /></span>
              </div>
            </a>
          ))
        }
      </div>
      <p class="center"><a class="btn btn--dark" href="/productos">Conocer portafolio de productos <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- SECTORES -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Sectores</p>
        <h2>Asesoría y suministros para tu sector</h2>
      </div>
      <div class="grid grid--3">
        {
          sectors.map((s) => (
            <article class="sector">
              <Img file={s.image} alt={`Sector ${s.name.toLowerCase()}`} sizes="(min-width: 1000px) 380px, 100vw" widths={[400, 640, 800]} />
              <div class="sector__body">
                <h3>{s.name}</h3>
                <p>{s.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- NOSOTROS -->
  <section class="section">
    <div class="container about">
      <div class="about__media">
        <Img file="asesoria-tecnica.jpg" alt="Asesores revisando planos de un proyecto" sizes="(min-width: 1000px) 520px, 100vw" />
        <div class="about__badge"><strong>45</strong><span>años de<br />experiencia</span></div>
      </div>
      <div>
        <p class="eyebrow">Nosotros</p>
        <h2>{site.legalName}</h2>
        <p class="lead">45 años de experiencia en el sector ferretero con <strong>especialización en recursos hídricos</strong>.</p>
        <p>
          Ofrecemos un catálogo de productos con altos estándares de calidad y acompañamos con asesoría y servicio técnico
          especializado, ayudando a <strong>diseñar, implementar y mantener</strong> sistemas de gestión de agua que maximizan la
          eficiencia y minimizan el desperdicio.
        </p>
        <ul class="check-list">
          <li>Asesoría para elegir el producto y la capacidad correcta</li>
          <li>Servicio técnico especializado</li>
          <li>Productos de alta resistencia y durabilidad</li>
        </ul>
        <a class="btn btn--dark" href="/nosotros">Conócenos <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Cómo trabajamos</p>
        <h2>Tu tanque en 4 pasos</h2>
      </div>
      <ol class="steps grid grid--4">
        {
          steps.map((s, i) => (
            <li>
              <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
              <Icon name={s.icon} size={30} />
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head section-head--center">
            <p class="eyebrow">Opiniones</p>
            <h2>Lo que dicen nuestros clientes</h2>
          </div>
          <div class="grid grid--3">
            {testimonials.map((t) => (
              <figure class="card quote">
                <blockquote>“{t.text}”</blockquote>
                <figcaption>
                  <strong>{t.name}</strong> · {t.place}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ + FORM -->
  <section class="section section--soft" id="cotizar">
    <div class="container grid grid--2 faq-form">
      <div>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>Resolvemos tus dudas</h2>
        <Faq items={faqs} />
      </div>
      <div>
        <p class="eyebrow">Cotización</p>
        <h2>Envía tu solicitud</h2>
        <ContactForm />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    isolation: isolate;
    color: #e3eef6;
    padding-block: clamp(72px, 12vw, 150px);
    overflow: hidden;
    background: var(--brand-900);
  }
  .hero :global(.hero__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(10 34 54 / 0.95) 0%, rgb(10 34 54 / 0.75) 45%, rgb(10 34 54 / 0.25) 100%),
      linear-gradient(0deg, rgb(10 34 54 / 0.6), transparent 40%);
  }
  .hero__inner {
    max-width: var(--container);
  }
  .hero h1 {
    color: #fff;
    max-width: 18ch;
  }
  .hero h1 span {
    color: var(--mustard-500);
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgb(217 232 174 / 0.15);
    border: 1px solid rgb(217 232 174 / 0.35);
    color: var(--lime-300);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 20px;
  }
  .hero__lead {
    font-size: clamp(1.1rem, 1.6vw, 1.25rem);
    max-width: 54ch;
    color: #c9dbe8;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 28px 0 44px;
  }
  .hero__stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
  }
  .hero__stats li {
    display: grid;
    padding-left: 14px;
    border-left: 3px solid var(--mustard-500);
  }
  .hero__stats strong {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.1;
  }
  .hero__stats span {
    font-size: 0.875rem;
    color: #a9c2d6;
  }

  /* PRODUCTOS */
  .products {
    display: grid;
    gap: clamp(16px, 2.5vw, 24px);
  }
  @media (min-width: 640px) {
    .products {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .products {
      grid-template-columns: repeat(3, 1fr);
    }
    .prod--wide {
      grid-row: span 2;
    }
    .prod--wide .prod__media {
      flex: 1;
    }
    .prod--wide .prod__media :global(img) {
      max-height: 420px;
    }
  }
  .prod {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--line);
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .prod:hover {
    color: var(--ink);
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .prod__media {
    display: grid;
    place-items: center;
    padding: 24px;
    background: radial-gradient(circle at 50% 60%, #fff 0%, var(--aqua-100) 85%);
    min-height: 220px;
  }
  .prod__media :global(img) {
    max-height: 260px;
    width: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.3s;
  }
  .prod:hover .prod__media :global(img) {
    transform: scale(1.04);
  }
  .prod__body {
    padding: 22px 26px 26px;
  }
  .prod__body p {
    color: var(--ink-soft);
    font-size: 0.975rem;
  }
  .prod__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--aqua-600);
  }
  .center {
    text-align: center;
    margin-top: 40px;
  }

  /* SECTORES */
  .sector {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    isolation: isolate;
    color: #fff;
  }
  .sector :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.5s;
  }
  .sector:hover :global(img) {
    transform: scale(1.05);
  }
  .sector::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(10 34 54 / 0.92) 0%, rgb(10 34 54 / 0.2) 55%, transparent);
  }
  .sector__body {
    position: absolute;
    inset: auto 0 0;
    padding: 28px;
  }
  .sector h3 {
    color: #fff;
    font-size: 1.5rem;
  }
  .sector h3::after {
    content: '';
    display: block;
    width: 40px;
    height: 3px;
    margin-top: 10px;
    background: var(--mustard-500);
  }
  .sector p {
    margin: 0;
    color: #dce9f2;
  }

  /* NOSOTROS */
  .about {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .about {
      grid-template-columns: 1fr 1.05fr;
    }
  }
  .about__media {
    position: relative;
  }
  .about__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .about__badge {
    position: absolute;
    right: -12px;
    bottom: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 22px;
    border-radius: var(--radius);
    background: var(--mustard-500);
    color: var(--brand-900);
    box-shadow: var(--shadow);
    line-height: 1.15;
  }
  .about__badge strong {
    font-size: 2.6rem;
    font-weight: 800;
  }
  .about__badge span {
    font-weight: 700;
    font-size: 0.9rem;
  }
  @media (max-width: 600px) {
    .about__badge {
      right: 12px;
      bottom: 12px;
    }
  }

  /* PROCESO */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .steps li {
    position: relative;
    padding: 28px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.1);
  }
  .steps li > :global(svg) {
    color: var(--aqua-300);
    margin-bottom: 14px;
  }
  .steps__n {
    position: absolute;
    top: 18px;
    right: 22px;
    font-size: 2.4rem;
    font-weight: 800;
    color: rgb(255 255 255 / 0.08);
  }
  .steps p {
    margin: 0;
    color: #a9c2d6;
  }

  .quote blockquote {
    margin: 0 0 16px;
    font-size: 1.05rem;
  }
  .quote figcaption {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .faq-form {
    align-items: start;
  }
</style>
