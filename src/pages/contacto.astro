---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../data/site';
import { breadcrumbSchema, localBusinessSchema } from '../lib/schema';

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Contacto', url: '/contacto' },
];
---

<Base
  title="Contacto y cotizaciones"
  description={`Cotiza tanques de agua, sistemas sépticos y valvulería. Visítanos en ${site.address.street}, Bogotá, o llámanos al ${site.contact.phone}.`}
  schema={[breadcrumbSchema(crumbs), { '@type': 'ContactPage', url: new URL('/contacto', site.url).href }, localBusinessSchema()]}
>
  <PageHero title="Contáctanos" lead="Envía tu solicitud para cotización. Para una respuesta más rápida, escríbenos por WhatsApp o llámanos." crumbs={crumbs} />
  <section class="section">
    <div class="container contact">
      <div class="info">
        <a class="btn btn--block" href={whatsappUrl()} target="_blank" rel="noopener" data-track="contacto">
          <Icon name="whatsapp" /> ¡Quiero cotizar!
        </a>
        <ul>
          <li><Icon name="phone" /><div><strong>Teléfono</strong><a href={`tel:${site.contact.phoneE164}`} data-track="contacto">{site.contact.phone}</a></div></li>
          <li><Icon name="mail" /><div><strong>Correo</strong><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></div></li>
          <li><Icon name="pin" /><div><strong>Dirección</strong><span>{site.address.street}, {site.address.locality} – Colombia</span><a href={site.address.mapsUrl} target="_blank" rel="noopener">Ver en Google Maps</a></div></li>
          {site.openingHoursText && <li><Icon name="clock" /><div><strong>Horario</strong><span>{site.openingHoursText}</span></div></li>}
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
  <section class="map" aria-label="Mapa de ubicación">
    <iframe
      title={`Ubicación de ${site.name}`}
      src={`https://www.google.com/maps?q=${encodeURIComponent(`${site.address.street}, ${site.address.locality}, Colombia`)}&output=embed`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .contact {
      grid-template-columns: 380px 1fr;
      gap: 64px;
    }
  }
  .info ul {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    gap: 22px;
  }
  .info li {
    display: flex;
    gap: 14px;
  }
  .info li > :global(svg) {
    flex: none;
    color: var(--brand-600);
  }
  .info li div {
    display: grid;
  }
  .map iframe {
    display: block;
    width: 100%;
    height: 420px;
    border: 0;
    filter: grayscale(0.3);
  }
</style>
