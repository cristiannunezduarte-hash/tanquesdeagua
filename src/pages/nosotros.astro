---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, sectors } from '../data/site';
import { breadcrumbSchema, BUSINESS_ID } from '../lib/schema';

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Nosotros', url: '/nosotros' },
];
---

<Base
  title="Nosotros: 45 años en recursos hídricos"
  description={`${site.legalName}: 45 años de experiencia en el sector ferretero con especialización en recursos hídricos. Tanques de agua, sistemas sépticos y valvulería en Bogotá.`}
  schema={[breadcrumbSchema(crumbs), { '@type': 'AboutPage', about: { '@id': BUSINESS_ID } }]}
>
  <PageHero title={site.legalName} lead="45 años de experiencia en el sector ferretero con especialización en recursos hídricos." crumbs={crumbs} />
  <section class="section">
    <div class="container about">
      <div class="prose">
        <p class="lead">
          Ofrecemos un catálogo de productos con altos estándares de calidad y acompañamos con asesoría y servicio técnico
          especializado.
        </p>
        <p>
          Ayudamos a nuestros clientes a <strong>diseñar, implementar y mantener</strong> sistemas de gestión de agua que
          maximizan la eficiencia y minimizan el desperdicio.
        </p>
        <!-- TODO: agregar la historia de la empresa, misión, visión y fotos reales del local/equipo -->
        <h2>Asesoría y suministros para</h2>
        <ul class="check-list">
          <li>Almacenamiento de agua</li>
          <li>Sistemas sépticos</li>
          <li>Valvulería</li>
        </ul>
        <h2>Sectores que atendemos</h2>
        <ul class="check-list">{sectors.map((s) => <li><strong>{s.name}:</strong> {s.text}</li>)}</ul>
      </div>
      <Img file="asesoria-tecnica.jpg" alt="Asesoría técnica en obra" class="about__img" sizes="(min-width: 960px) 480px, 100vw" />
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .about {
    display: grid;
    gap: 48px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .about {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .about :global(.about__img) {
    width: 100%;
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
</style>
