---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceImage from '../../components/ServiceImage.astro';
import Faq from '../../components/Faq.astro';
import ContactForm from '../../components/ContactForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { site, services, whatsappUrl, type Service } from '../../data/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const url = `/servicios/${service.slug}`;
const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Servicios', url: '/servicios' },
  { name: service.name, url },
];
const others = services.filter((s) => s.slug !== service.slug);
const schema: object[] = [serviceSchema(service, url), breadcrumbSchema(crumbs)];
if (service.faqs.length) schema.push(faqSchema(service.faqs));
const waMsg = `Hola, quiero cotizar: ${service.name}.`;
---

<Base title={`${service.name} en ${site.address.locality}`} description={service.metaDescription} schema={schema}>
  <PageHero title={`${service.name} en ${site.address.locality}`} lead={service.short} crumbs={crumbs}>
    <div class="actions">
      <a class="btn btn--whatsapp" href={whatsappUrl(waMsg)} target="_blank" rel="noopener" data-track={service.slug}>
        <Icon name="whatsapp" /> Cotizar por WhatsApp
      </a>
      <a class="btn btn--ghost" href="#formulario">Formulario de cotización</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container detail">
      <article class="prose">
        <ServiceImage file={service.image} alt={`${service.name} realizado por ${site.name}`} icon={service.icon} priority class="detail__img" />
        <p class="lead">{service.intro}</p>

        <h2>¿Qué incluye el servicio?</h2>
        <ul class="check-list">{service.includes.map((x) => <li>{x}</li>)}</ul>

        <h2>Beneficios</h2>
        <ul class="check-list">{service.benefits.map((x) => <li>{x}</li>)}</ul>

        <h2>Zonas de cobertura</h2>
        <p>
          Prestamos el servicio de {service.name.toLowerCase()} en {site.areaServed.join(', ')}.
        </p>

        {
          service.faqs.length > 0 && (
            <>
              <h2>Preguntas frecuentes</h2>
              <Faq items={service.faqs} />
            </>
          )
        }
      </article>

      <aside class="side">
        <h2 class="side__title">Cotiza este servicio</h2>
        <ContactForm selected={service.slug} />
        <nav class="card others" aria-label="Otros servicios">
          <h2 class="side__title">Otros servicios</h2>
          <ul>{others.map((s) => <li><a href={`/servicios/${s.slug}`}><Icon name={s.icon} size={20} /> {s.name}</a></li>)}</ul>
        </nav>
      </aside>
    </div>
  </section>
  <CtaBand message={waMsg} />
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .detail {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 1000px) {
    .detail {
      grid-template-columns: minmax(0, 1fr) 400px;
      gap: 64px;
    }
    .side {
      position: sticky;
      top: 96px;
      align-self: start;
    }
  }
  .detail :global(.detail__img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: 28px;
  }
  .side {
    display: grid;
    gap: 24px;
  }
  .side__title {
    font-size: 1.25rem;
    margin: 0;
  }
  .others ul {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 4px;
  }
  .others a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    font-weight: 600;
    text-decoration: none;
  }
</style>
