---
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../data/site';
const { title = '¿Necesitas un tanque de agua?', text = 'Cotiza sin compromiso y recibe asesoría de expertos con 45 años de experiencia.', message } =
  Astro.props as { title?: string; text?: string; message?: string };
---

<section class="cta">
  <div class="container">
    <div class="cta__box">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta__actions">
        <a class="btn" href={whatsappUrl(message)} target="_blank" rel="noopener" data-track="cta">
          <Icon name="whatsapp" /> Escríbenos por WhatsApp
        </a>
        <a class="btn btn--light" href={`tel:${site.contact.phoneE164}`} data-track="cta">
          <Icon name="phone" /> ¡Llamar ahora!
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(48px, 7vw, 88px);
  }
  .cta__box {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 24px;
    align-items: center;
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-lg);
    color: #e4e8d6;
    background:
      radial-gradient(600px 300px at 100% 0%, rgb(207 198 45 / 0.35), transparent 60%),
      linear-gradient(135deg, var(--brand-600), var(--brand-900));
  }
  @media (min-width: 860px) {
    .cta__box {
      grid-template-columns: 1fr auto;
    }
  }
  h2 {
    color: #fff;
  }
  p {
    margin: 0;
    font-size: 1.1rem;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
