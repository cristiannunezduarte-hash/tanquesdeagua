---
/** Acordeón de preguntas frecuentes sin JavaScript (<details>) */
const { items } = Astro.props as { items: readonly { q: string; a: string }[] };
---

<div class="faq">
  {
    items.map((f, i) => (
      <details open={i === 0}>
        <summary>
          <h3>{f.q}</h3>
        </summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 12px;
  }
  details {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 4px 24px;
    transition: box-shadow 0.2s;
  }
  details[open] {
    box-shadow: var(--shadow-sm);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--brand-50);
    color: var(--brand-700);
    font-size: 1.4rem;
    font-weight: 500;
    transition: transform 0.2s;
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  h3 {
    margin: 0;
    font-size: 1.075rem;
  }
  p {
    color: var(--ink-soft);
    padding-bottom: 8px;
  }
</style>
