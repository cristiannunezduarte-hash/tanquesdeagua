---
/**
 * Formulario de cotización.
 * - Funciona sin JavaScript (POST normal → /gracias).
 * - Con JavaScript envía por fetch y muestra el resultado sin recargar.
 * - Protegido con Cloudflare Turnstile (captcha invisible y gratuito) + honeypot + rate limit.
 * - Turnstile se carga solo cuando el formulario entra en pantalla (no afecta la velocidad).
 */
import { services, site } from '../data/site';

// Clave pública de Turnstile. La de prueba "1x00000000000000000000AA" siempre pasa.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
const { selected = '' } = Astro.props as { selected?: string };
---

<form class="form card" id="formulario" method="post" action="/api/contacto" novalidate>
  <div class="form__row">
    <label>
      <span>Nombre *</span>
      <input name="nombre" autocomplete="name" required minlength="2" maxlength="80" />
    </label>
    <label>
      <span>Teléfono / WhatsApp *</span>
      <input name="telefono" type="tel" autocomplete="tel" inputmode="tel" required maxlength="25" />
    </label>
  </div>
  <div class="form__row">
    <label>
      <span>Correo (opcional)</span>
      <input name="email" type="email" autocomplete="email" maxlength="120" />
    </label>
    <label>
      <span>Ciudad / barrio</span>
      <input name="ciudad" list="ciudades" autocomplete="address-level2" maxlength="60" />
      <datalist id="ciudades">{site.areaServed.map((c) => <option value={c} />)}</datalist>
    </label>
  </div>
  <div class="form__row">
    <label>
      <span>Servicio</span>
      <select name="servicio">
        <option value="">Selecciona…</option>
        {services.map((s) => <option value={s.name} selected={s.slug === selected}>{s.name}</option>)}
        <option value="Otro">Otro</option>
      </select>
    </label>
    <label>
      <span>Capacidad aproximada</span>
      <select name="capacidad">
        <option value="">No sé</option>
        <option>Hasta 1.000 L</option>
        <option>1.000 – 5.000 L</option>
        <option>5.000 – 20.000 L</option>
        <option>Más de 20.000 L</option>
      </select>
    </label>
  </div>
  <label>
    <span>Cuéntanos más (opcional)</span>
    <textarea name="mensaje" rows="4" maxlength="1500"></textarea>
  </label>

  <!-- Honeypot anti-bots -->
  <label class="hp" aria-hidden="true">Sitio web <input name="empresa_web" tabindex="-1" autocomplete="off" /></label>
  <input type="hidden" name="pagina" />
  <input type="hidden" name="utm_source" />
  <input type="hidden" name="utm_medium" />
  <input type="hidden" name="utm_campaign" />

  <div class="cf-turnstile" data-sitekey={siteKey} data-language="es" data-appearance="interaction-only"></div>

  <button class="btn btn--block" type="submit">Solicitar cotización gratis</button>
  <p class="form__status" role="status" aria-live="polite"></p>
  <p class="form__legal">
    Al enviar aceptas nuestra <a href="/politica-de-privacidad">política de tratamiento de datos</a>.
  </p>
</form>

<script>
  const form = document.getElementById('formulario') as HTMLFormElement | null;
  if (form) {
    const params = new URLSearchParams(location.search);
    const set = (name: string, value: string) => {
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      if (el) el.value = value;
    };
    set('pagina', location.pathname);
    ['utm_source', 'utm_medium', 'utm_campaign'].forEach((k) => set(k, params.get(k) ?? ''));
    const status = form.querySelector('.form__status') as HTMLElement;
    const error = params.get('error');
    if (error) status.textContent = error;

    // Cargar Turnstile solo cuando el formulario sea visible
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
        s.async = true;
        document.head.appendChild(s);
      },
      { rootMargin: '400px' },
    );
    io.observe(form);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      status.textContent = 'Enviando…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const data = (await res.json()) as { ok: boolean; error?: string };
        if (data.ok) {
          location.href = '/gracias';
          return;
        }
        status.textContent = data.error ?? 'No se pudo enviar. Intenta por WhatsApp.';
      } catch {
        status.textContent = 'Error de conexión. Intenta de nuevo o escríbenos por WhatsApp.';
      }
      btn.disabled = false;
      (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
    });
  }
</script>

<style>
  .form {
    display: grid;
    gap: 16px;
  }
  .form__row {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 600px) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  label {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.925rem;
    color: var(--brand-900);
  }
  input,
  select,
  textarea {
    font: inherit;
    font-weight: 400;
    width: 100%;
    min-height: 50px;
    padding: 12px 14px;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--ink);
    transition: border-color 0.15s;
  }
  textarea {
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--brand-500);
    box-shadow: 0 0 0 4px var(--brand-100);
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .form__status:empty {
    display: none;
  }
  .form__status {
    margin: 0;
    font-weight: 600;
    color: var(--brand-700);
  }
  .form__legal {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
</style>
