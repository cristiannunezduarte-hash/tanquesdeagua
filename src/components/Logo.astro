---
import { site } from '../data/site';
// TODO: si la marca tiene logo, reemplaza el SVG por <Image src={logo} ... />
const { light = false } = Astro.props as { light?: boolean };
---

<span class:list={['logo', { 'logo--light': light }]}>
  <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
    <rect width="40" height="40" rx="11" fill="#0f3552"></rect>
    <path d="M20 7s-9 9.6-9 16a9 9 0 0 0 18 0C29 16.6 20 7 20 7Z" fill="#8fd3ea"></path>
    <path d="M14.5 24c1.8-1.3 3.7-1.3 5.5 0s3.7 1.3 5.5 0" stroke="#cfc62d" stroke-width="2.2" fill="none" stroke-linecap="round"
    ></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">{site.name}</span>
    <span class="logo__tag">{site.tagline}</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--brand-900);
  }
  .logo--light {
    color: #fff;
  }
  svg {
    width: 40px;
    height: 40px;
    flex: none;
  }
  .logo__text {
    display: grid;
    line-height: 1.1;
  }
  .logo__name {
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .logo__tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-500);
  }
  .logo--light .logo__tag {
    color: var(--lime-300);
  }
</style>
