---
import { site } from '../data/site';
// TODO: si la marca tiene logo, reemplaza el SVG por <Image src={logo} ... />
const { light = false } = Astro.props as { light?: boolean };
---

<span class:list={['logo', { 'logo--light': light }]}>
  <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
    <defs>
      <linearGradient id="lg-drop" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#18b6d6"></stop>
        <stop offset="1" stop-color="#0f6fc6"></stop>
      </linearGradient>
    </defs>
    <path d="M20 3s-12 13-12 21.5a12 12 0 0 0 24 0C32 16 20 3 20 3Z" fill="url(#lg-drop)"></path>
    <path d="M12.5 25c2.5-1.8 5-1.8 7.5 0s5 1.8 7.5 0" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round"
    ></path>
  </svg>
  <span class="logo__text">{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--brand-900);
  }
  .logo--light {
    color: #fff;
  }
  svg {
    width: 36px;
    height: 36px;
  }
</style>
