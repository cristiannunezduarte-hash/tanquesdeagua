---
const { items } = Astro.props as { items: { name: string; url: string }[] };
---

<nav aria-label="Ruta de navegación" class="crumbs">
  <ol>
    {
      items.map((it, i) => (
        <li>{i < items.length - 1 ? <a href={it.url}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
  li:not(:last-child)::after {
    content: '/';
    margin-left: 6px;
    opacity: 0.5;
  }
  a {
    color: inherit;
  }
</style>
